# Папка исходных Excel. Пусто или «.» = общая папка Инвет (родитель проекта).
# Можно указать относительный путь от корня проекта, например: ..
# INVENTORY_DATA_DIR=..

# Папка итоговых отчётов. По умолчанию — та же общая папка Инвет.
# INVENTORY_OUTPUT_DIR=..

# Период анализа в днях
PERIOD_DAYS=30

# Минимальный балл схожести для перекрытия пересорта
MIN_OVERLAP_SCORE=20

# Включить аналитическое перекрытие между магазинами (0/1)
ENABLE_CROSS_STORE=0
